# Copy this file to .env.local and fill in the values from
# Supabase dashboard > Project Settings > API Keys.
# Without these, the app runs in content preview: the tool library, picker,
# and Learn pages work, and sign-in, the shop, and community are off.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
